# =============================================================================
# .gitignore — Road Accident Severity Prediction
# =============================================================================

# ---- Byte-compiled / optimized / DLL files ----
__pycache__/
*.py[cod]
*$py.class

# ---- C extensions ----
*.so

# ---- Distribution / packaging ----
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---- PyInstaller ----
*.manifest
*.spec

# ---- Installer logs ----
pip-log.txt
pip-delete-this-directory.txt

# ---- Unit test / coverage reports ----
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# ---- Jupyter Notebook ----
.ipynb_checkpoints

# ---- IPython ----
profile_default/
ipython_config.py

# ---- Environments ----
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ---- pyenv ----
.python-version

# ---- IDE / Editor settings ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS-specific files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Project-specific: Dataset & Model Artifacts ----
# Raw and processed datasets should not be pushed to GitHub (size/privacy)
Dataset/raw/*.csv
Dataset/processed/*
Dataset/external/*
!Dataset/raw/.gitkeep
!Dataset/processed/.gitkeep
!Dataset/external/.gitkeep

# Trained model artifacts
models/trained/*
models/evaluation/*
!models/trained/.gitkeep
!models/evaluation/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# Reports/figures generated at runtime
reports/figures/*
!reports/figures/.gitkeep

# ---- Streamlit ----
.streamlit/

# ---- MLflow / Experiment tracking (future use) ----
mlruns/
mlartifacts/

# ---- Miscellaneous ----
*.log
*.bak
*.tmp
